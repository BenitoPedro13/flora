# Copy to .env and fill in. Validated at boot by packages/config/src/env.ts —
# every app fails loudly at startup if a variable here is missing or malformed,
# never silently at first use.

NODE_ENV=development

# Postgres + PostGIS (infra/docker-compose.yml: db)
DATABASE_URL=postgresql://flora:flora@localhost:5432/flora

# Redis (infra/docker-compose.yml: cache)
REDIS_URL=redis://localhost:6379

# Object storage — MinIO locally (infra/docker-compose.yml: storage), Cloudflare R2 in prod
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=flora
S3_SECRET_ACCESS_KEY=flora-dev-secret
S3_BUCKET=flora-rasters

# Mapbox GL JS — public token, safe to expose to the browser
NEXT_PUBLIC_MAPBOX_TOKEN=

# Copernicus Data Space Ecosystem (Sentinel Hub) OAuth2 client — unused until Phase 2
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Session/auth
JWT_SIGNING_KEY=

# CORS origin for apps/api
WEB_ORIGIN=http://localhost:3000
