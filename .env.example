# Copy to .env and fill in. Validated at boot by packages/config/src/env.ts —
# every app fails loudly at startup if a variable here is missing or malformed,
# never silently at first use.

NODE_ENV=development

# Postgres + PostGIS (infra/docker-compose.yml: db). DATABASE_URL is the
# flora_app role — no BYPASSRLS, subject to every RLS policy (invariant 6,
# TASK-auth-tenancy §2.1.4). apps/api and apps/worker assert this at boot and
# exit 1 if pointed at the owner instead. DATABASE_MIGRATION_URL is the owner
# (flora) — used only by packages/db scripts (migrate, generate, studio, seed).
DATABASE_URL=postgresql://flora_app:flora-app-dev-secret@localhost:5432/flora
DATABASE_MIGRATION_URL=postgresql://flora:flora@localhost:5432/flora

# Redis (infra/docker-compose.yml: cache)
REDIS_URL=redis://localhost:6379

# Object storage — MinIO locally (infra/docker-compose.yml: storage), Cloudflare R2 in prod
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=flora
S3_SECRET_ACCESS_KEY=flora-dev-secret
S3_BUCKET=flora-rasters
# The public base URL apps/api composes a raster's object key onto to build
# the URL it returns — never a signed URL (invariant 2). MinIO locally, once
# infra/docker-compose.yml's createbuckets step has set the bucket to public
# read; the real R2 public bucket URL in prod.
R2_PUBLIC_BASE_URL=http://localhost:9000/flora-rasters

# Mapbox GL JS — public token, safe to expose to the browser. Required from
# TASK-fields on: without a real token, /fields renders MapPlaceholder instead
# of the field boundaries (packages/config's env schema still requires this
# var be non-empty at apps/api boot — apps/web reads it directly and degrades
# gracefully on an invalid or placeholder value instead of crashing).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Copernicus Data Space Ecosystem (Sentinel Hub) OAuth2 client. Optional
# (TASK-satellite-pipeline §2.12) — only apps/worker reads these, and only
# when it actually calls CDSE; a blank value no longer fails any app's boot,
# so TASK-crop-stress can be built off db:seed:satellite with no CDSE account.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Daily 03:00 farm-local refresh scheduling. Default false — nobody wants a
# 3am job firing against live CDSE quota from a laptop.
SATELLITE_SCHEDULE_ENABLED=false

# TASK-home-dashboard: daily 03:30 farm-local rollup scheduling and hourly
# Open-Meteo weather ingest. Neither has quota to protect the way CDSE does —
# default false just keeps a laptop quiet, same as SATELLITE_SCHEDULE_ENABLED.
ROLLUP_SCHEDULE_ENABLED=false
WEATHER_SCHEDULE_ENABLED=false
# Open-Meteo needs no API key for non-commercial use (CC-BY 4.0 attribution,
# 10,000 calls/day free tier — verified 2026-08-16). Leave unset in every real
# environment; only packages/weather's fixture tests override this.
OPEN_METEO_BASE_URL=

# Session/auth (architecture §10, TASK-auth-tenancy §2.3). JWT_SIGNING_KEY
# must be >= 32 bytes — asserted at boot. TTLs default to 15 min / 30 days if
# unset; only override to change that.
JWT_SIGNING_KEY=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000

# CORS origin for apps/api, and where apps/web proxies /api/v1/* to
# (next.config.ts rewrites) so cookies stay same-origin in every environment
# (architecture §14, TASK-auth-tenancy §7). API_URL is read server-side only —
# never NEXT_PUBLIC_ — so the API's real origin is never shipped to the browser.
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001
