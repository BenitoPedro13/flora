{
  "name": "@flora/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "migrate": "dotenv -e ../../.env -- tsx src/migrate.ts",
    "studio": "dotenv -e ../../.env -- drizzle-kit studio",
    "spike:roundtrip": "dotenv -e ../../.env -- tsx src/queries/spike-roundtrip.ts"
  },
  "dependencies": {
    "@flora/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@flora/config": "workspace:*",
    "@turf/turf": "7.4.0",
    "@types/pg": "8.21.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
