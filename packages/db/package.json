{
  "name": "@flora/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./test/containers": "./src/test/containers.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "migrate": "dotenv -e ../../.env -- tsx src/migrate.ts",
    "studio": "dotenv -e ../../.env -- drizzle-kit studio",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "seed:demo": "dotenv -e ../../.env -- tsx src/seed-demo.ts",
    "seed:bulk": "dotenv -e ../../.env -- tsx src/seed-bulk.ts"
  },
  "dependencies": {
    "@flora/contracts": "workspace:*",
    "@node-rs/argon2": "2.1.0",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@flora/config": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@turf/turf": "7.4.0",
    "@types/pg": "8.21.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
