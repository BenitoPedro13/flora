{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "pnpm run start:dev",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "dotenv -e ../../.env -- nest start",
    "start:dev": "dotenv -e ../../.env -- nest start --watch",
    "start:debug": "dotenv -e ../../.env -- nest start --debug --watch",
    "start:prod": "dotenv -e ../../.env -- node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "test:watch": "dotenv -e ../../.env -- vitest",
    "test:cov": "dotenv -e ../../.env -- vitest run --coverage"
  },
  "dependencies": {
    "@flora/config": "workspace:*",
    "@flora/contracts": "workspace:*",
    "@flora/db": "workspace:*",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "6.5.0",
    "@node-rs/argon2": "2.1.0",
    "bullmq": "6.1.1",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.2",
    "express": "^5.2.1",
    "ioredis": "6.0.0",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "1.16.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.21.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "1.5.11",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  }
